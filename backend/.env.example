# Copy to backend/.env to change any of these. Every value has a working
# default: with no .env at all the system runs fully offline.

# --- Optional AI providers -------------------------------------------------
# Leave both credential paths empty to stay completely offline (the default).
# Either path below is enough on its own; you don't need both.

# Path A: AI Studio. Simplest -- one key, no billing setup.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Path B: Vertex AI, if you're already on GCP.
#   1. Set VERTEX_PROJECT to your GCP project id. Billing must be linked to
#      it and the Vertex AI API must be enabled, or calls fail.
#   2. Create a service account with the "Vertex AI User" role, download its
#      JSON key, and save it as backend/vertex-key.json -- that exact path
#      is already gitignored (see .gitignore), so it can't be committed by
#      accident. Full walkthrough in the README's "Getting a Vertex AI
#      service-account key" section.
#   3. Point GOOGLE_APPLICATION_CREDENTIALS below at that file's ABSOLUTE
#      path (a relative path resolves against wherever the process happens
#      to start, which is not reliable):
GOOGLE_APPLICATION_CREDENTIALS=
#   Vertex AI's Gemini models only answer on the "global", "us" or "eu"
#   Interactions API locations -- a regional location like "us-central1"
#   returns a 404 even though the model shows up fine in that region's
#   model catalog listing. VERTEX_LOCATION defaults to "global".
VERTEX_PROJECT=
# VERTEX_LOCATION=global

# Region detection via Gemini. Much more reliable than the offline detector
# on real-world photos (clean, semantically correct polygons vs. the offline
# detector's colour-clustering, which can produce overlapping nonsense on a
# cluttered or renovation-in-progress facade). AI Studio's flash models have
# a free tier; Vertex AI bills per call regardless of model.
ENABLE_AI_SEGMENTATION=false
AI_SEGMENTATION_MODEL=gemini-3.8-flash
# "minimal" is documented for this model but Vertex AI rejects it
# ("Thinking level is unsupported") while AI Studio accepts it. "low" works
# on both, so it's the default; only change this if you've verified otherwise.
# AI_THINKING_LEVEL=low

# Photoreal "HD render" pass over the offline composite.
# NOTE: Gemini image models have NO free tier on either path (~$0.034+ per image).
ENABLE_AI_RENDER=false
AI_RENDER_MODEL=gemini-nano-banana-2.1

# --- Storage ---------------------------------------------------------------
# DATABASE_URL=sqlite:///./renovation.db
# STORAGE_DIR=../storage

# --- Image handling --------------------------------------------------------
# MAX_UPLOAD_MB=25
# MAX_IMAGE_EDGE=2048
# DISPLAY_EDGE=1400

# --- Deployment --------------------------------------------------------
# Only needed once the frontend is served from a different origin than this
# API (e.g. frontend on Vercel, this backend on its own host). A JSON array
# -- pydantic-settings parses list-typed .env values as JSON, not CSV:
# CORS_ORIGINS=["https://your-app.vercel.app"]
# Local dev already works with no entry here: main.py also allows any
# http://localhost:* or http://127.0.0.1:* origin via a regex, which this
# list is additional to, not a replacement for.
